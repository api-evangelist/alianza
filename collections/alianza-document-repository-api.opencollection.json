{
  "opencollection": "1.0.0",
  "info": {
    "name": "Alianza Public Document Repository API",
    "version": "2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-AUTH-TOKEN",
      "value": "{{X-AUTH-TOKEN}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Document Repository",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a document version",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.d2.alianza.com/v2/document-repository/document-version/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a document version"
        },
        {
          "info": {
            "name": "Get a document version content",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.d2.alianza.com/v2/document-repository/document-content/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a document version content"
        }
      ]
    }
  ],
  "bundled": true
}