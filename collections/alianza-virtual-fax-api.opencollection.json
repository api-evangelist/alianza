{
  "opencollection": "1.0.0",
  "info": {
    "name": "Alianza Virtual Fax API",
    "version": "2"
  },
  "items": [
    {
      "info": {
        "name": "Virtual Fax",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve Outbound Virtual Fax Configuration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.d2.alianza.com/v2/partition/:partitionId/account/:accountId/vfax/outbound",
            "headers": [
              {
                "name": "X-AUTH-TOKEN",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "partitionId",
                "value": "",
                "type": "path",
                "description": "ID of partition"
              },
              {
                "name": "accountId",
                "value": "",
                "type": "path",
                "description": "ID of account"
              }
            ]
          },
          "docs": "Use to retrieve the outbound vfax configuration on an account"
        },
        {
          "info": {
            "name": "Update Outbound Virtual Fax Configuration",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.d2.alianza.com/v2/partition/:partitionId/account/:accountId/vfax/outbound",
            "headers": [
              {
                "name": "X-AUTH-TOKEN",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "partitionId",
                "value": "",
                "type": "path",
                "description": "ID of partition"
              },
              {
                "name": "accountId",
                "value": "",
                "type": "path",
                "description": "ID of account"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Use to configure outbound vfax for an account"
        }
      ]
    }
  ],
  "bundled": true
}