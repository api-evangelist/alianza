      "item": [
        {
          "id": "26b983b1-68e7-45b9-8dff-697a15fb4f93",
          "name": "Initiate SSO Authentication (Service Provider-Initiated Flow)",
          "request": {
            "name": "Initiate SSO Authentication (Service Provider-Initiated Flow)",
            "description": {
              "content": "Initiates the SSO authentication process by redirecting the user to their configured Identity Provider (IdP).\n\nWhat this endpoint does:\n1. Looks up the SSO configuration based on the user's email domain\n2. Generates a SAML authentication request\n3. Returns the SAML request in a 200 or 303 response depending on request parameters\n\nNote: This does not authenticate the user directly. It starts the redirect flow to the IdP.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "authn",
                "sso",
                ":emailAddress"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "redirect",
                  "value": "true",
                  "description": "When true, returns HTTP 303 and may include a Location header.\nWhen false, returns HTTP 200 with the redirect URL in the response body.\n"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<email>",
                  "key": "emailAddress",
                  "description": "(Required) The user's email address, used to identify the SSO configuration by email domain"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "Optional redirect URL override for specific applications.\nIf provided, the user will be redirected to this URL after successful authentication instead of the default callback URL.\n",
                "key": "X-AUTH-REDIRECT-OVERRIDE",
                "value": "<uri>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null
          },
          "response": [
            {
              "id": "62d205f1-a7f2-40bf-a35a-e16ca7237953",
