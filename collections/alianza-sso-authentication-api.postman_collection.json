        {
          "id": "fafd5c03-f067-4786-899a-72bb85144710",
          "name": "Complete SSO Authentication (IdP Callback)",
          "request": {
            "name": "Complete SSO Authentication (IdP Callback)",
            "description": {
              "content": "Completes the SSO authentication flow after the user has authenticated with their Identity Provider.\n\nFlow:\n1. User authenticates at the IdP\n2. IdP sends SAML assertion to Auth0\n3. Auth0 exchanges it for an authorization code\n4. This endpoint receives the code and exchanges it for user tokens\n5. Returns a LoginTokenX object for authenticated API use\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "authn",
                "sso",
                "login-callback"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "code",
                  "value": "<string>",
                  "description": "(Required) Authorization code from Auth0 after successful IdP authentication"
                },
                {
                  "disabled": false,
                  "key": "redirect_uri",
                  "value": "<uri>",
                  "description": "(Required) Must exactly match the URI used in the initial authentication request"
                },
                {
                  "disabled": false,
                  "key": "state",
                  "value": "<string>",
                  "description": "(Required) State token for session tracking and CSRF protection.\nContains the SSO configuration scope level.\n"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null
          },
          "response": [
